# ==============================================================================
# Empleado Digital - Backend (NestJS + Prisma ORM)
# Configuracion local con integraciones reales (sin mocks ni simuladores)
# ==============================================================================

# --- Aplicacion ---
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# --- Base de datos PostgreSQL en Supabase (solo BD, sin Supabase Auth) ---
# DATABASE_URL apunta al pooler Supavisor (puerto 6543 con ?pgbouncer=true)
# DIRECT_URL apunta a la conexion directa (puerto 5432) para migraciones Prisma
DATABASE_URL=
DIRECT_URL=

# --- Seguridad local, JWT y cifrado AES-256-GCM ---
# Secretos JWT de minimo 32 caracteres
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_2FA_TEMP_SECRET=
# Clave maestra de 32 bytes en formato hexadecimal (64 caracteres hex)
ENCRYPTION_KEY=
TOTP_ISSUER=Empleado Digital

# --- Google Gemini API (Agente IA real) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Meta WhatsApp Business Cloud API ---
META_APP_SECRET=
META_VERIFY_TOKEN=
META_API_VERSION=v21.0

# --- Google Cloud (Calendar API v3 OAuth2 + Maps Platform) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google-calendar/callback
GOOGLE_MAPS_API_KEY=

# --- PayPal Developer Sandbox REST API v2 ---
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- Tunel HTTPS local (cloudflared) para webhooks reales ---
PUBLIC_TUNNEL_URL=
