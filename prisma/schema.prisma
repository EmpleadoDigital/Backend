generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==============================================================================
// Enums del dominio
// ==============================================================================

enum PlanCode {
  FREE
  BASIC
  PRO
}

enum BusinessType {
  BARBERSHOP
  SALON
  CLINIC
  RESTAURANT
  HOTEL
  SPA
  OTHER
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  STAFF
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOCKOUT
  TWO_FACTOR_ENABLED  @map("2FA_ENABLED")
  TWO_FACTOR_DISABLED @map("2FA_DISABLED")
  TWO_FACTOR_FAILED   @map("2FA_FAILED")
  TOKEN_ROTATED
  TOKEN_REUSE_DETECTED
  SECRET_UPDATED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMATION_SENT
  CONFIRMED
  CANCELLED
  NO_SHOW
  COMPLETED
}

enum AppointmentPaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  TRANSFER
  PAYPAL_SANDBOX
  CARD_EXTERNAL
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum DiscountScope {
  ALL
  SERVICES
  PRODUCTS
}

enum PromotionSegment {
  ALL
  FREQUENT
  INACTIVE
  CUSTOM
}

enum CampaignSource {
  MANUAL
  COPILOT
}

enum CampaignStatus {
  DRAFT
  SENT
}

enum PaymentProvider {
  MANUAL
  PAYPAL_SANDBOX
}

enum PaymentRecordStatus {
  PENDING
  PAID
  FAILED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEMPLATE
  TEXT
  INTERACTIVE
  LOCATION
}

enum MessageDeliveryStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum CopilotPlanStatus {
  PENDING_APPROVAL
  PARTIALLY_APPROVED
  EXECUTED
  REJECTED
}

// ==============================================================================
// 1-3. SaaS & Planes
// ==============================================================================

model Plan {
  id                   String         @id @default(cuid())
  code                 PlanCode       @unique
  name                 String
  monthlyPriceMxn      Decimal        @db.Decimal(10, 2)
  setupFeeMxn          Decimal        @default(0) @db.Decimal(10, 2)
  maxUsers             Int
  maxResources         Int
  maxAppointmentsMonth Int?
  maxCustomers         Int?
  maxProducts          Int?
  maxAiRequestsMonth   Int            @default(0)
  featuresJson         Json
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  subscriptions        Subscription[]

  @@map("plans")
}

model Tenant {
  id                        String                     @id @default(cuid())
  name                      String
  slug                      String                     @unique
  businessType              BusinessType               @default(OTHER)
  customerLabel             String                     @default("Cliente")
  resourceLabel             String                     @default("Recurso")
  address                   String?
  googlePlaceId             String?
  lat                       Float?
  lng                       Float?
  arrivalNotes              String?
  bankClabeEnc              String?
  logoUrl                   String?
  onboardingCompleted       Boolean                    @default(false)
  isActive                  Boolean                    @default(true)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  subscription              Subscription?
  users                     User[]
  securityAuditLogs         SecurityAuditLog[]
  resources                 Resource[]
  services                  Service[]
  customers                 Customer[]
  appointments              Appointment[]
  googleCalendarConnections GoogleCalendarConnection[]
  products                  Product[]
  sales                     Sale[]
  discountRules             DiscountRule[]
  promotionCampaigns        PromotionCampaign[]
  paymentRecords            PaymentRecord[]
  whatsappChannel           WhatsAppChannel?
  conversations             Conversation[]
  messageLogs               MessageLog[]
  copilotSessions           CopilotSession[]
  copilotActionPlans        CopilotActionPlan[]
  agentExecutionLogs        AgentExecutionLog[]

  @@map("tenants")
}

model Subscription {
  id                   String             @id @default(cuid())
  tenantId             String             @unique
  planId               String
  status               SubscriptionStatus @default(ACTIVE)
  paypalSubscriptionId String?            @unique
  currentPeriodStart   DateTime           @default(now())
  currentPeriodEnd     DateTime
  aiRequestsUsed       Int                @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                 Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId])
  @@map("subscriptions")
}

// ==============================================================================
// 4-7. Autenticacion Local, 2FA TOTP y Auditoria de Seguridad
// ==============================================================================

model User {
  id                  String                @id @default(cuid())
  tenantId            String?
  email               String                @unique
  passwordHash        String
  fullName            String
  phone               String?
  role                UserRole              @default(OWNER)
  twoFactorEnabled    Boolean               @default(false)
  twoFactorSecretEnc  String?
  failedLoginAttempts Int                   @default(0)
  lockedUntil         DateTime?
  isActive            Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  tenant              Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens       RefreshToken[]
  backupCodes         TwoFactorBackupCode[]
  securityAuditLogs   SecurityAuditLog[]
  resources           Resource[]
  copilotSessions     CopilotSession[]
  approvedPlans       CopilotActionPlan[]   @relation("ApprovedActionPlans")

  @@index([tenantId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  familyId  String
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model TwoFactorBackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor_backup_codes")
}

model SecurityAuditLog {
  id           String            @id @default(cuid())
  tenantId     String?
  userId       String?
  eventType    SecurityEventType
  ipAddress    String?
  metadataJson Json?
  createdAt    DateTime          @default(now())
  tenant       Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@map("security_audit_logs")
}

// ==============================================================================
// 8-12. Configuracion, Clientes, Agenda y Google Calendar API v3
// ==============================================================================

model Resource {
  id                        String                     @id @default(cuid())
  tenantId                  String
  userId                    String?
  name                      String
  typeLabel                 String
  color                     String                     @default("#FFC93C")
  workingHoursJson          Json
  isActive                  Boolean                    @default(true)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  tenant                    Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                      User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments              Appointment[]
  googleCalendarConnections GoogleCalendarConnection[]

  @@index([tenantId])
  @@index([userId])
  @@map("resources")
}

model Service {
  id            String        @id @default(cuid())
  tenantId      String
  name          String
  description   String?
  durationMin   Int
  bufferMin     Int           @default(0)
  price         Decimal       @db.Decimal(10, 2)
  depositAmount Decimal?      @db.Decimal(10, 2)
  color         String        @default("#2B2D31")
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments  Appointment[]

  @@index([tenantId])
  @@map("services")
}

model Customer {
  id             String          @id @default(cuid())
  tenantId       String
  fullName       String
  phone          String
  email          String?
  tags           String[]        @default([])
  notes          String?
  totalVisits    Int             @default(0)
  lastVisitAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments   Appointment[]
  sales          Sale[]
  paymentRecords PaymentRecord[]
  conversations  Conversation[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("customers")
}

model Appointment {
  id                String                   @id @default(cuid())
  tenantId          String
  customerId        String
  resourceId        String
  serviceId         String
  startAt           DateTime
  endAt             DateTime
  status            AppointmentStatus        @default(SCHEDULED)
  paymentStatus     AppointmentPaymentStatus @default(UNPAID)
  priceTotal        Decimal                  @db.Decimal(10, 2)
  amountPaid        Decimal                  @default(0) @db.Decimal(10, 2)
  googleEventId     String?
  recoveredFromSlot Boolean                  @default(false)
  notes             String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer          Customer                 @relation(fields: [customerId], references: [id], onDelete: Restrict)
  resource          Resource                 @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  service           Service                  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  sales             Sale[]
  paymentRecords    PaymentRecord[]

  @@index([tenantId, startAt])
  @@index([tenantId, resourceId, startAt, endAt])
  @@map("appointments")
}

model GoogleCalendarConnection {
  id                String    @id @default(cuid())
  tenantId          String
  resourceId        String?
  googleEmail       String
  calendarId        String    @default("primary")
  accessTokenEnc    String
  refreshTokenEnc   String
  tokenExpiresAt    DateTime?
  syncToken         String?
  watchChannelId    String?   @unique
  watchResourceId   String?
  watchChannelToken String?
  watchExpiresAt    DateTime?
  lastSyncedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resource          Resource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([resourceId])
  @@map("google_calendar_connections")
}

// ==============================================================================
// 13-18. Comercial, Marketing y Cobranza
// ==============================================================================

model Product {
  id        String     @id @default(cuid())
  tenantId  String
  sku       String?
  name      String
  category  String?
  salePrice Decimal    @db.Decimal(10, 2)
  costPrice Decimal    @db.Decimal(10, 2)
  stock     Int        @default(0)
  minStock  Int        @default(0)
  imageUrl  String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saleItems SaleItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@map("products")
}

model Sale {
  id             String          @id @default(cuid())
  tenantId       String
  customerId     String?
  appointmentId  String?
  discountRuleId String?
  subtotal       Decimal         @db.Decimal(10, 2)
  discountTotal  Decimal         @default(0) @db.Decimal(10, 2)
  total          Decimal         @db.Decimal(10, 2)
  profitMargin   Decimal         @db.Decimal(10, 2)
  paymentMethod  PaymentMethod
  soldAt         DateTime        @default(now())
  createdAt      DateTime        @default(now())
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  appointment    Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  discountRule   DiscountRule?   @relation(fields: [discountRuleId], references: [id], onDelete: SetNull)
  items          SaleItem[]
  paymentRecords PaymentRecord[]

  @@index([tenantId, soldAt])
  @@map("sales")
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  unitCost  Decimal @db.Decimal(10, 2)
  lineTotal Decimal @db.Decimal(10, 2)
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model DiscountRule {
  id                 String              @id @default(cuid())
  tenantId           String
  name               String
  code               String?
  type               DiscountType
  value              Decimal             @db.Decimal(10, 2)
  startsAt           DateTime
  endsAt             DateTime
  isActive           Boolean             @default(true)
  applicableScope    DiscountScope       @default(ALL)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales              Sale[]
  promotionCampaigns PromotionCampaign[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("discount_rules")
}

model PromotionCampaign {
  id                String           @id @default(cuid())
  tenantId          String
  title             String
  messageTemplate   String
  discountRuleId    String?
  targetSegment     PromotionSegment @default(ALL)
  slotStart         DateTime?
  slotEnd           DateTime?
  source            CampaignSource   @default(MANUAL)
  status            CampaignStatus   @default(DRAFT)
  recipientsCount   Int              @default(0)
  bookingsConverted Int              @default(0)
  sentAt            DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  discountRule      DiscountRule?    @relation(fields: [discountRuleId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@map("promotion_campaigns")
}

model PaymentRecord {
  id              String              @id @default(cuid())
  tenantId        String
  appointmentId   String?
  saleId          String?
  customerId      String?
  amount          Decimal             @db.Decimal(10, 2)
  currency        String              @default("MXN")
  provider        PaymentProvider
  paypalOrderId   String?             @unique
  paypalCaptureId String?             @unique
  approvalUrl     String?
  status          PaymentRecordStatus @default(PENDING)
  paidAt          DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment     Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  sale            Sale?               @relation(fields: [saleId], references: [id], onDelete: SetNull)
  customer        Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@map("payment_records")
}

// ==============================================================================
// 19-21. Meta WhatsApp Business Cloud API Real
// ==============================================================================

model WhatsAppChannel {
  id                   String   @id @default(cuid())
  tenantId             String   @unique
  phoneNumberId        String   @unique
  wabaId               String
  displayPhone         String
  encryptedAccessToken String
  templatesSyncedJson  Json?
  webhookVerified      Boolean  @default(false)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("whatsapp_channels")
}

model Conversation {
  id               String       @id @default(cuid())
  tenantId         String
  customerId       String
  lastMessageAt    DateTime?
  lastInboundAt    DateTime?
  automationPaused Boolean      @default(false)
  escalationReason String?
  unreadCount      Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer         Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages         MessageLog[]

  @@unique([tenantId, customerId])
  @@index([tenantId, lastMessageAt])
  @@map("conversations")
}

model MessageLog {
  id             String                @id @default(cuid())
  tenantId       String
  conversationId String
  direction      MessageDirection
  messageType    MessageType
  body           String
  metaMessageId  String?               @unique
  deliveryStatus MessageDeliveryStatus @default(SENT)
  createdAt      DateTime              @default(now())
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation   Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId, conversationId, createdAt])
  @@map("message_logs")
}

// ==============================================================================
// 22-24. Copiloto Google Gemini y Auditoria IA
// ==============================================================================

model CopilotSession {
  id           String              @id @default(cuid())
  tenantId     String
  userId       String
  title        String
  messagesJson Json                @default("[]")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plans        CopilotActionPlan[]

  @@index([tenantId, userId])
  @@map("copilot_sessions")
}

model CopilotActionPlan {
  id              String              @id @default(cuid())
  tenantId        String
  sessionId       String
  promptText      String
  status          CopilotPlanStatus   @default(PENDING_APPROVAL)
  planPayloadJson Json
  approvedById    String?
  executedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session         CopilotSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  approvedBy      User?               @relation("ApprovedActionPlans", fields: [approvedById], references: [id], onDelete: SetNull)
  executionLogs   AgentExecutionLog[]

  @@index([tenantId, status])
  @@map("copilot_action_plans")
}

model AgentExecutionLog {
  id                  String             @id @default(cuid())
  tenantId            String
  planId              String?
  model               String
  toolsCalledJson     Json               @default("[]")
  inputTokens         Int                @default(0)
  outputTokens        Int                @default(0)
  executionResultJson Json?
  createdAt           DateTime           @default(now())
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                CopilotActionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("agent_execution_logs")
}
